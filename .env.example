# Copy to .env.local (it is git-ignored) and fill in. Values are public: they end up in the browser bundle.
# Зугаагийн Supabase төсөл: Project Settings → API (URL, anon/publishable key)
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Зугаа апп-ын хаяг (төгсгөлд / -гүй). "Гүйлгээ хийсэн" дарахад Telegram мессежийг тэр илгээнэ.
VITE_ZUGAA_URL=https://read.zugaa.mn
