# Сайт (build үед, нээлттэй утга). Cloudflare Pages → Settings → Variables and Secrets-д ч мөн нэмнэ.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Сервер (functions/) — зөвхөн Cloudflare Pages-ийн Secret-д. Энд, git-д бодит утга бичихгүй.
# Локалд `npx wrangler pages dev` ажиллуулахдаа .dev.vars файлд бичнэ (git-д орохгүй).
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_TELEGRAM_IDS=
TELEGRAM_WEBHOOK_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=kinotube
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
