# Copy to .env.local for `npx vercel dev`; on Vercel set the same names in Project → Settings → Environment Variables.

# Supabase → Project Settings → API. Public: they end up in the browser bundle.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel Functions in api/). Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_TELEGRAM_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Tests only: point the bot client at a mock Bot API
# TELEGRAM_API_BASE=http://127.0.0.1:8099
